NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://calma:calma@localhost:5432/calma_workspace
TEST_DATABASE_URL=postgres://calma:calma@localhost:5433/calma_workspace_test

# Replace this value outside local development. It must be at least 32 characters.
JWT_SECRET=replace-this-development-secret-with-at-least-32-characters
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Booking values are centralized in src/config/index.js.
MAX_DURATION_HOURS=8
MAX_ROOM_CAPACITY=1000
BUFFER_MINUTES=15
HOURLY_RATE_MILLIMES=5000
DAILY_RATE_MILLIMES=25000
OPENING_TIME=08:00
CLOSING_TIME=20:00
TIMEZONE=Africa/Tunis

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
JSON_BODY_LIMIT=100kb
CORS_ORIGIN=http://localhost:5173
